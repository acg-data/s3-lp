{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "s3-brickell-lander",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-12",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "artifacts/studio-three/dist/public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["justin@aryocg.com"],
      "allowed_destination_addresses": ["justin@aryocg.com"],
    },
  ],
  "d1_databases": [
    {
      "binding": "LEADS",
      "database_name": "s3-brickell-inquiries",
      "database_id": "3a3d1eb9-4c98-4e77-b441-0ff342605dbb",
      "migrations_dir": "migrations",
    },
  ],
  "triggers": { "crons": ["*/5 * * * *"] },
  "ratelimits": [
    {
      "name": "INQUIRY_LIMITER",
      "namespace_id": "310091",
      "simple": { "limit": 10, "period": 60 },
    },
  ],
  "vars": {
    "FRONTEND_ORIGIN": "",
    "LEAD_RECIPIENT": "justin@aryocg.com",
    "EMAIL_FROM": "justin@aryocg.com",
    "EMAIL_ENABLED": "false",
  },
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "env": {
    "dev": {
      "name": "s3-brickell-lander-dev",
      "workers_dev": true,
      "send_email": [
        {
          "name": "EMAIL",
          "allowed_sender_addresses": ["justin@aryocg.com"],
          "allowed_destination_addresses": ["justin@aryocg.com"],
        },
      ],
      "d1_databases": [
        {
          "binding": "LEADS",
          "database_name": "s3-brickell-inquiries-dev",
          "database_id": "66ef7fec-6990-447d-9af4-f0625f61a805",
          "migrations_dir": "migrations",
        },
      ],
      "triggers": { "crons": ["*/5 * * * *"] },
      "ratelimits": [
        {
          "name": "INQUIRY_LIMITER",
          "namespace_id": "310092",
          "simple": { "limit": 10, "period": 60 },
        },
      ],
      "vars": {
        "FRONTEND_ORIGIN": "",
        "LEAD_RECIPIENT": "justin@aryocg.com",
        "EMAIL_FROM": "justin@aryocg.com",
        "EMAIL_ENABLED": "false",
      },
    },
  },
}
