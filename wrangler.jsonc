{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "s3-brickell-lander",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-12",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "artifacts/studio-three/dist/public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "send_email": [{ "name": "EMAIL" }],
  "ratelimits": [
    {
      "name": "INQUIRY_LIMITER",
      "namespace_id": "310091",
      "simple": { "limit": 10, "period": 60 },
    },
  ],
  "vars": {
    "FRONTEND_ORIGIN": "",
    "LEAD_RECIPIENT": "",
    "EMAIL_FROM": "",
  },
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "env": {
    "dev": {
      "name": "s3-brickell-lander-dev",
      "workers_dev": true,
      "send_email": [{ "name": "EMAIL" }],
      "ratelimits": [
        {
          "name": "INQUIRY_LIMITER",
          "namespace_id": "310092",
          "simple": { "limit": 10, "period": 60 },
        },
      ],
      "vars": {
        "FRONTEND_ORIGIN": "",
        "LEAD_RECIPIENT": "",
        "EMAIL_FROM": "",
      },
    },
  },
}
