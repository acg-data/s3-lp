{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "s3-brickell-lander",
  "workers_dev": true,
  "routes": [
    { "pattern": "studiothreefounders.com", "custom_domain": true },
    { "pattern": "www.studiothreefounders.com", "custom_domain": true },
  ],
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-12",
  "compatibility_flags": ["nodejs_compat"],
  "secrets": {
    "required": [
      "RESEND_API_KEY",
      "COMMS_API_KEY",
      "RESEND_WEBHOOK_SECRET",
      "DELIVERY_LINK_SECRET",
    ],
  },
  "assets": {
    "directory": "artifacts/studio-three/dist/public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true,
  },
  "d1_databases": [
    {
      "binding": "LEADS",
      "database_name": "s3-brickell-inquiries",
      "database_id": "3a3d1eb9-4c98-4e77-b441-0ff342605dbb",
      "migrations_dir": "migrations",
    },
  ],
  "triggers": { "crons": ["*/5 * * * *"] },
  "ratelimits": [
    {
      "name": "INQUIRY_LIMITER",
      "namespace_id": "310091",
      "simple": { "limit": 10, "period": 60 },
    },
  ],
  "vars": {
    "FRONTEND_ORIGIN": "",
    "LEAD_RECIPIENT": "justin@aryocg.com,adriana@studiothree.com",
    "EMAIL_FROM": "notifications@studiothreefounders.com",
    "EMAIL_ENABLED": "true",
    "CONFIRMATION_EMAIL_ENABLED": "true",
    "CONFIRMATION_REPLY_TO": "adriana@studiothree.com",
    "COMMS_ENABLED": "true",
    "COMMS_LINE": "+12103933771",
    "PUBLIC_ORIGIN": "https://studiothreefounders.com",
    "DELIVERY_PROJECT": "studio-three-brickell",
  },
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "env": {
    "dev": {
      "name": "s3-brickell-lander-dev",
      "workers_dev": true,
      "routes": [],
      "secrets": {
        "required": [
          "RESEND_API_KEY",
          "COMMS_API_KEY",
          "RESEND_WEBHOOK_SECRET",
          "DELIVERY_LINK_SECRET",
        ],
      },
      "d1_databases": [
        {
          "binding": "LEADS",
          "database_name": "s3-brickell-inquiries-dev",
          "database_id": "66ef7fec-6990-447d-9af4-f0625f61a805",
          "migrations_dir": "migrations",
        },
      ],
      "triggers": { "crons": ["*/5 * * * *"] },
      "ratelimits": [
        {
          "name": "INQUIRY_LIMITER",
          "namespace_id": "310092",
          "simple": { "limit": 10, "period": 60 },
        },
      ],
      "vars": {
        "FRONTEND_ORIGIN": "",
        "LEAD_RECIPIENT": "justin@aryocg.com,adriana@studiothree.com",
        "EMAIL_FROM": "justin@automator.aryocg.com",
        "EMAIL_ENABLED": "true",
        "CONFIRMATION_EMAIL_ENABLED": "true",
        "CONFIRMATION_REPLY_TO": "adriana@studiothree.com",
        "COMMS_ENABLED": "true",
        "COMMS_LINE": "+12103933771",
        "PUBLIC_ORIGIN": "https://s3-brickell-lander-dev.justin-b75.workers.dev",
        "DELIVERY_PROJECT": "studio-three-brickell-dev",
      },
    },
  },
}
